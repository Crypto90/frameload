+
+static void wait_balance_before_wait(XrSession session) {
+    pthread_mutex_lock(&wait_lock);
+    if (wait_pending) {
+        struct timespec until;
+        clock_gettime(CLOCK_REALTIME, &until);
+        until.tv_nsec += (long)WAIT_BALANCE_MS * 1000000L;
+        until.tv_sec += until.tv_nsec / 1000000000L;
+        until.tv_nsec %= 1000000000L;
+        while (wait_pending && pthread_cond_timedwait(&wait_cond, &wait_lock, &until) == 0) {}
+    }
+    if (wait_pending) {
+        PFN_xrBeginFrame begin = (PFN_xrBeginFrame)lookup(active_instance, "xrBeginFrame");
+        PFN_xrEndFrame end = (PFN_xrEndFrame)lookup(active_instance, "xrEndFrame");
+        XrFrameBeginInfo begin_info = {XR_TYPE_FRAME_BEGIN_INFO, NULL};
+        XrResult rb = begin ? begin(session, &begin_info) : XR_ERROR_FUNCTION_UNSUPPORTED;
+        XrFrameEndInfo empty = {XR_TYPE_FRAME_END_INFO, NULL, last_predicted_time, XR_ENVIRONMENT_BLEND_MODE_OPAQUE, 0,
+                                NULL};
+        XrResult re = XR_SUCCEEDED(rb) && end ? end(session, &empty) : rb;
+        wait_pending = 0;
+        static int logged;
+        if (logged++ < 5)
+            LOG("wait_balance: a waited frame was not begun within %d ms; began and ended it empty (begin %d, end %d)",
+                WAIT_BALANCE_MS, rb, re);
+    }
+    pthread_mutex_unlock(&wait_lock);
+}
+
+static void wait_balance_frame_begun(void) {
+    pthread_mutex_lock(&wait_lock);
+    wait_pending = 0;
+    pthread_cond_broadcast(&wait_cond);
+    pthread_mutex_unlock(&wait_lock);
 }
 
